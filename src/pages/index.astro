---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BearScene from '@/components/bears/BearScene.astro';
import BearAvatar from '@/components/bears/BearAvatar.astro';
import { BEARS } from '@/components/bears/parts/bodies';
import { lessonsByStage, lessonHref, allLessons } from '@/lib/course';
import { BEAR_IDS } from '@/components/bears/parts/geometry';

const groups = await lessonsByStage();
const lessons = await allLessons();
const first = lessons[0];
const total = lessons.length;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="熊熊小教室"
  description="從零開始學台股技術分析。K 線、型態、指標由淺入深，每個概念都配可以動手拉參數的真實線圖，也誠實告訴你每個工具什麼時候會失效。"
>
  <section class="hero">
    <div class="hero__text">
      <p class="hero__kicker">台股技術分析 · 從零開始</p>
      <h1>看懂線圖，<br />而不是背訊號</h1>
      <p class="hero__lede">
        技術分析最難的不是記住「黃金交叉要買」，而是知道<b>它什麼時候會騙你</b>。
        這裡的每一課都配一張可以動手拉參數的真實台股線圖，
        每個指標都會同時給你成功的案例與失敗的案例。
      </p>
      <div class="hero__cta">
        {first && <a class="btn btn--go" href={lessonHref(first.id)}>從第一課開始</a>}
        <a class="btn" href={`${base}lab/`}>直接玩指標實驗室</a>
      </div>
      <p class="hero__meta">目前 {total} 課 · 資料為證交所真實日線 · 完全免費、不需註冊</p>
    </div>

    <div class="hero__art">
      <BearScene size={128} />
    </div>
  </section>

  <section class="why">
    <h2 class="sr-only">這個網站的做法</h2>
    <ul class="why__grid" role="list">
      <li class="why__card">
        <span class="why__ico" aria-hidden="true">◧</span>
        <b>先講原理，再講用法</b>
        <p>每個指標都從「它到底在算什麼」開始。理解了公式在幹嘛，用法自己就推得出來，不用死背。</p>
      </li>
      <li class="why__card">
        <span class="why__ico" aria-hidden="true">◎</span>
        <b>參數可以自己拉</b>
        <p>把週期從 5 拖到 240，看線怎麼從貼著價格跑變成一條直線。三秒鐘勝過三段文字。</p>
      </li>
      <li class="why__card">
        <span class="why__ico" aria-hidden="true">⚠</span>
        <b>失敗案例照放</b>
        <p>我們會用真實數據算給你看，黃金交叉四年半下來為什麼還輸給什麼都不做。</p>
      </li>
      <li class="why__card">
        <span class="why__ico" aria-hidden="true">台</span>
        <b>台股的現實</b>
        <p>漲跌停、除權息缺口、當沖——這些歐美教材不會講，但它們真的會改變你看到的線圖。</p>
      </li>
    </ul>
  </section>

  <section class="cast">
    <h2>三位老師，三種聲音</h2>
    <p class="cast__lede">
      同一個訊號，激進的人跟謹慎的人會做出完全相反的決定，而兩邊都有道理。
      與其給你一個中立到沒有立場的說法，不如讓他們吵給你看。
    </p>
    <div class="cast__grid">
      {
        BEAR_IDS.map((id) => (
          <article class="cast__card">
            <BearAvatar
              bear={id}
              mood={id === 'duo' ? 'excited' : id === 'kong' ? 'worried' : 'thinking'}
              size={104}
              decorative
            />
            <b>{BEARS[id].name}</b>
            <span class="cast__role">{BEARS[id].role}</span>
            <p>{BEARS[id].duty}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="map">
    <h2>學習地圖</h2>
    {
      groups.map(({ stage, lessons: items }) => (
        <div class="map__stage" style={`--accent:${stage.accent}`}>
          <div class="map__head">
            <BearAvatar bear={stage.bear} mood="neutral" size={44} decorative class="map__bear" />
            <div>
              <h3>
                <span class="map__ord">{stage.ordinal}</span> {stage.title}
              </h3>
              <p>{stage.pitch}</p>
            </div>
            <span class="map__count">{items.length > 0 ? `${items.length} 課` : '撰寫中'}</span>
          </div>

          {items.length > 0 && (
            <ul class="map__list" role="list">
              {items.map((l) => (
                <li>
                  <a href={lessonHref(l.id)}>{l.data.title}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
    <p class="map__more">
      <a href={`${base}lessons/`}>看完整課程總覽 →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0 3rem;
  }

  .hero__kicker {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--c-brand-deep);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .hero h1 {
    font-size: clamp(1.9rem, 5.5vw, 3rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .hero__lede {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.95;
    color: var(--c-ink-soft);
    max-width: 34rem;
  }

  .hero__lede b {
    color: var(--c-ink);
    background: linear-gradient(transparent 62%, var(--c-accent) 62%);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.55rem 1.35rem;
    border: 2px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-ink);
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-sticker-sm);
  }

  .btn:hover {
    box-shadow: var(--shadow-sticker);
    transform: translate(-1px, -1px);
  }

  .btn--go {
    background: var(--c-brand);
    color: var(--c-on-brand);
  }

  .hero__meta {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--c-ink-faint);
  }

  .hero__art {
    display: grid;
    place-items: center;
  }

  .why {
    margin: 1rem 0 3.5rem;
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .why__card {
    border: 2px solid var(--c-line);
    border-radius: var(--radius-bear);
    background: var(--c-surface);
    box-shadow: var(--shadow-sticker-sm);
    padding: 1rem 1.15rem 1.15rem;
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .why__ico {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-accent-wash);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  .why__card b {
    font-size: 1rem;
  }

  .why__card p {
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--c-ink-soft);
  }

  .cast {
    margin-bottom: 3.5rem;
  }

  .cast h2,
  .map h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .cast__lede {
    color: var(--c-ink-soft);
    line-height: 1.9;
    max-width: 42rem;
    margin-bottom: 1.25rem;
  }

  .cast__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.85rem;
  }

  .cast__card {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.15rem;
    padding: 1.25rem 1rem 1.35rem;
    border: 2px solid var(--c-line);
    border-radius: var(--radius-bear);
    background: var(--c-surface);
    box-shadow: var(--shadow-sticker);
  }

  .cast__card b {
    font-size: 1.15rem;
    margin-top: 0.4rem;
  }

  .cast__role {
    font-size: 0.8125rem;
    color: var(--c-brand-deep);
  }

  .cast__card p {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--c-ink-soft);
  }

  .map__stage {
    margin-bottom: 1.25rem;
    border: 2px solid var(--c-line);
    border-left-width: 8px;
    border-left-color: var(--accent);
    border-radius: var(--radius-bear);
    background: var(--c-surface);
    padding: 0.9rem 1.15rem 1rem;
  }

  .map__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .map__bear {
    flex: none;
    border: 2px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface-2);
  }

  .map__head h3 {
    font-size: 1.05rem;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .map__ord {
    font-size: 0.7rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: #3d3230;
  }

  .map__head p {
    font-size: 0.8125rem;
    color: var(--c-ink-soft);
    line-height: 1.7;
    margin-top: 0.1rem;
  }

  .map__count {
    margin-left: auto;
    flex: none;
    align-self: flex-start;
    font-size: 0.75rem;
    color: var(--c-ink-faint);
    white-space: nowrap;
  }

  .map__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .map__list a {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 2px solid var(--c-line-soft);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--c-ink-soft);
    text-decoration: none;
  }

  .map__list a:hover {
    border-color: var(--c-line);
    background: var(--c-accent-wash);
    color: var(--c-ink);
  }

  .map__more {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  .map__more a {
    color: var(--c-brand-deep);
    font-weight: 700;
    text-decoration: none;
  }

  .map__more a:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      text-align: left;
    }

    .hero__art {
      order: -1;
    }
  }
</style>
