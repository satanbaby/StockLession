---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BearAvatar from '@/components/bears/BearAvatar.astro';
import { lessonsByStage, lessonHref, difficultyStars } from '@/lib/course';

const groups = await lessonsByStage();
const total = groups.reduce((n, g) => n + g.lessons.length, 0);
---

<BaseLayout title="課程總覽" description="四個階段、由淺入深的台股技術分析課程。">
  <header class="head">
    <h1>課程總覽</h1>
    <p>
      四個階段循序漸進，從「K 線在說什麼」一路到「怎麼把指標組成有紀律的方法」。
      每一課都配可以動手拉參數的真實台股線圖，也都會誠實告訴你這個工具什麼時候會失效。
    </p>
    <p class="head__count" data-progress-summary>目前開放 {total} 課</p>
  </header>

  {
    groups.map(({ stage, lessons }) => (
      <section class="stage" style={`--accent:${stage.accent}`}>
        <header class="stage__head">
          <BearAvatar bear={stage.bear} mood="happy" size={62} decorative class="stage__bear" />
          <div>
            <h2>
              <span class="stage__ord">{stage.ordinal}</span>
              {stage.title}
            </h2>
            <p>{stage.pitch}</p>
          </div>
        </header>

        {lessons.length === 0 ? (
          <p class="stage__soon">這一階的課程撰寫中。</p>
        ) : (
          <ol class="cards">
            {lessons.map((l, i) => (
              <li>
                <a class="card" href={lessonHref(l.id)} data-lesson-id={l.id}>
                  <span class="card__no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="card__body">
                    <b class="card__title">{l.data.title}</b>
                    <span class="card__sum">{l.data.summary}</span>
                    <span class="card__meta">
                      <span>約 {l.data.minutes} 分鐘</span>
                      <span class="card__stars" title={`難度 ${l.data.difficulty} / 5`}>
                        {difficultyStars(l.data.difficulty)}
                      </span>
                    </span>
                  </span>
                  <span class="card__check" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ol>
        )}
      </section>
    ))
  }
</BaseLayout>

<script>
  import { completed } from '@/lib/progress';

  function paint() {
    const done = completed();
    for (const a of document.querySelectorAll<HTMLElement>('[data-lesson-id]')) {
      a.classList.toggle('is-done', done.has(a.dataset.lessonId ?? ''));
    }
    const summary = document.querySelector<HTMLElement>('[data-progress-summary]');
    const total = document.querySelectorAll('[data-lesson-id]').length;
    if (summary && done.size > 0) {
      summary.textContent = `目前開放 ${total} 課 · 你已讀完 ${done.size} 課`;
    }
  }

  paint();
  document.addEventListener('progress:change', paint);
</script>

<style>
  .head {
    margin-bottom: 2.5rem;
  }

  .head h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .head p {
    color: var(--c-ink-soft);
    line-height: 1.9;
    max-width: 44rem;
  }

  .head__count {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--c-ink-faint);
  }

  .stage {
    margin-bottom: 2.75rem;
  }

  .stage__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: 3px solid var(--accent);
  }

  .stage__bear {
    flex: none;
    border: 2px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface-2);
  }

  .stage__head h2 {
    font-size: 1.3rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .stage__ord {
    font-size: 0.75rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    color: #3d3230;
  }

  .stage__head p {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--c-ink-soft);
    line-height: 1.75;
  }

  .stage__soon {
    padding: 1rem 1.25rem;
    border: 2px dashed var(--c-line-soft);
    border-radius: var(--radius-bear);
    color: var(--c-ink-faint);
    font-size: 0.9375rem;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .card {
    display: grid;
    grid-template-columns: 2.4rem 1fr 1.4rem;
    gap: 0.85rem;
    align-items: start;
    padding: 0.9rem 1.1rem;
    border: 2px solid var(--c-line);
    border-radius: var(--radius-bear);
    background: var(--c-surface);
    box-shadow: var(--shadow-sticker-sm);
    text-decoration: none;
    color: var(--c-ink);
  }

  .card:hover {
    background: var(--c-accent-wash);
    box-shadow: var(--shadow-sticker);
  }

  .card__no {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    -webkit-text-stroke: 0.5px var(--c-line);
  }

  .card__body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .card__title {
    font-size: 1.02rem;
  }

  .card__sum {
    font-size: 0.875rem;
    color: var(--c-ink-soft);
    line-height: 1.75;
  }

  .card__meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.75rem;
    color: var(--c-ink-faint);
    margin-top: 0.15rem;
  }

  .card__stars {
    letter-spacing: 0.1em;
    color: var(--c-brown);
  }

  .card__check {
    width: 1.4rem;
    height: 1.4rem;
    border: 2px solid var(--c-line-soft);
    border-radius: 999px;
    align-self: center;
  }

  .card.is-done .card__check {
    background: var(--c-down);
    border-color: var(--c-down);
    position: relative;
  }

  .card.is-done .card__check::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }
</style>
