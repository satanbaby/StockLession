---
/** Renders the selected bear with a real mood-specific transparent WebP. */
import { BEARS } from './parts/bodies';
import type { BearId, BearMood } from './parts/geometry';

interface Props {
  bear: BearId;
  mood?: BearMood;
  /** Rendered width and height in CSS pixels. */
  size?: number;
  /** Mirror the character horizontally. */
  flip?: boolean;
  /** Hide the image from assistive technology when it is purely decorative. */
  decorative?: boolean;
  class?: string;
}

const {
  bear,
  mood = 'neutral',
  size = 88,
  flip = false,
  decorative = false,
  class: className = '',
} = Astro.props;

const skin = BEARS[bear];
---

<img
  class:list={['bear-avatar', `bear-avatar--${mood}`, className]}
  src={skin.images[mood]}
  width={size}
  height={size}
  style={`--avatar-flip:${flip ? -1 : 1}`}
  alt={decorative ? '' : `${skin.name}（${skin.role}）`}
  aria-hidden={decorative ? 'true' : undefined}
  decoding="async"
/>

<style>
  .bear-avatar {
    display: block;
    object-fit: contain;
    object-position: center;
    transform: scaleX(var(--avatar-flip, 1));
    transform-origin: center;
  }
</style>
